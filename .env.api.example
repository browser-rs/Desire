# desire-api 环境变量

# 数据库连接串
DATABASE_URL=mysql://root:root@127.0.0.1:3306/desire

# 环境：dev / prod
DESIRE_ENV=dev

# JWT 密钥（DESIRE_ENV=prod 时禁止使用默认值，启动即失败）
DESIRE_API_JWT_SECRET=api-dev-secret

# 监听地址（默认 0.0.0.0:18090）
DESIRE_API_BIND_ADDR=0.0.0.0:18090

# token 有效期（秒，默认 7200 / 1209600）
# DESIRE_API_ACCESS_TTL=7200
# DESIRE_API_REFRESH_TTL=1209600

# Redis 缓存地址(可选;空 = 业务直连 DB)
# DESIRE_REDIS_URL=redis://:password@127.0.0.1:6379/0

# 注册开关的环境覆盖(优先级高于 server_settings 表里的 allow_registration)。
# 日常管理建议用 `desire-admin registration on|off`(写 DB,立即生效,无需重启);
# 此变量留给"强制封死"场景(设 0 后 CLI 也开不了,需先移除变量)。
# DESIRE_API_ALLOW_REGISTRATION=1

# 迁移:dev 默认启动时自动跑;prod 由 desire-migrate 执行器单独跑。
# 任何环境可用此变量强制覆盖(=1 强开 / =0 强关)
# DESIRE_MIGRATE_ON_START=1

# 迁移目录覆盖(默认依次探测 ./migrations、crates/common/migrations)
# MIGRATIONS_DIR=crates/common/migrations
