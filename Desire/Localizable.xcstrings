    "Derived from saved conversations. Only calls that reported usage count — conversations from before this was recorded show 0." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derived from saved conversations. Only calls that reported usage count — conversations from before this was recorded show 0."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "统计来自已存盘的对话。只有服务端上报过用量的调用才计入——记录功能上线之前的对话显示 0。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "統計來自已存盤的對話。只有服務端上報過用量的呼叫才計入——記錄功能上線之前的對話顯示 0。"
          }
        }
      }
    },
