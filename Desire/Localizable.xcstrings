    },
    "The server didn't respond. The site may be down, or a firewall is blocking the connection. Try reloading, or open the same URL in Safari to test." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server didn't respond. The site may be down, or a firewall is blocking the connection. Try reloading, or open the same URL in Safari to test."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器没有响应。网站可能宕机，或防火墙拦截了连接。请尝试重新加载，或在 Safari 中打开同一网址测试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器沒有回應。網站可能當機，或防火牆阻擋了連線。請嘗試重新載入，或在 Safari 開啟相同網址測試。"
          }
        }
      }
    },
    "The site requires a client certificate. Open Settings → Privacy → Certificates to manage installed client certs." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The site requires a client certificate. Open Settings → Privacy → Certificates to manage installed client certs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该网站需要客户端证书。打开 设置 → 隐私 → 证书 管理已安装的客户端证书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該網站需要用戶端憑證。開啟 設定 → 隱私權 → 憑證 以管理已安裝的用戶端憑證。"
          }
        }
      }
    },
    "The site's certificate is not trusted by macOS. This often means your system clock is wrong, or a corporate / security product is intercepting the connection. Check Date & Time in System Settings, then reload." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The site's certificate is not trusted by macOS. This often means your system clock is wrong, or a corporate / security product is intercepting the connection. Check Date & Time in System Settings, then reload."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该网站的证书不受 macOS 信任。这通常意味着系统时间不正确，或企业/安全软件正在拦截连接。请在系统设置中检查日期与时间，然后重新加载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該網站的憑證不受 macOS 信任。這通常表示系統時間不正確，或企業/資安軟體正在攔截連線。請在系統設定中檢查日期與時間，然後重新載入。"
          }
        }
      }
    },
    "These tools will run without asking for approval each time." : {
