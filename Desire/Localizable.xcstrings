    "Desire can't reach the network. Check that Wi-Fi or Ethernet is on, and that no app is in Airplane Mode." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desire can't reach the network. Check that Wi-Fi or Ethernet is on, and that no app is in Airplane Mode."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desire 无法访问网络。请检查 Wi-Fi 或以太网是否已开启，以及是否开启了飞行模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desire 無法存取網路。請檢查 Wi-Fi 或乙太網路是否已開啟，以及是否開啟了飛航模式。"
          }
        }
      }
    },
