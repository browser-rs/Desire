<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple Handoff 接收声明（v0.8.67 批 2）：activityType 与 mac 端
	     HandoffRelay.activityType 同源（BrowsingWebPage = Safari 同款；若被
	     系统强路由给 Safari，两端一起换成 me.siwi.Desire.browsing）。 -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>BrowsingWebPage</string>
		<string>me.siwi.Desire.browsing</string>
	</array>
</dict>
</plist>
