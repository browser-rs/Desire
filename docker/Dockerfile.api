# syntax=docker/dockerfile:1
# desire-api（用户接口）专用镜像

ARG REGISTRY=registry.cn-shenzhen.aliyuncs.com/pura

# ---------- builder ----------
FROM ${REGISTRY}/rust:1.98-trixie AS builder
WORKDIR /build

COPY docker/config.toml /usr/local/cargo/config.toml
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

# 多架构并行构建时,裸 cache mount 默认 sharing=shared,两个 cargo 并发写
# registry 解包会撞 "File exists";target 产物还互覆盖。按架构分 id + 加锁。
ARG TARGETARCH
RUN --mount=type=cache,id=release-target-${TARGETARCH},target=/build/target,sharing=locked \
    --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    cargo build --release -p desire-api \
    --locked \
    && mkdir -p /out \
    && cp target/release/desire-api /out/app

# ---------- runner ----------
FROM ${REGISTRY}/debian:trixie
# 安装 CA 证书和必要的运行时依赖（如 libc）
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 10001 desire \
    && useradd --uid 10001 --gid desire --no-create-home --shell /usr/sbin/nologin desire

WORKDIR /app
COPY --from=builder /out/app /app/app

USER desire
EXPOSE 18090
ENTRYPOINT ["/app/app"]
