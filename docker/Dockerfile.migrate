# syntax=docker/dockerfile:1
# desire-migrate:迁移执行器(one-shot)。只跑迁移,不承载业务。
# 部署: docker run --rm -e DATABASE_URL=... -e MIGRATIONS_DIR=/app/migrations desire-migrate
# 改迁移文件后只需重建本镜像;api 无需为迁移重建。

ARG REGISTRY=registry.cn-shenzhen.aliyuncs.com/pura

# ---------- builder ----------
FROM ${REGISTRY}/rust:1.98-trixie AS builder
WORKDIR /build

COPY docker/config.toml /usr/local/cargo/config.toml
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

# 多架构并行构建同 Dockerfile.api(按架构分 id + 加锁)
ARG TARGETARCH
RUN --mount=type=cache,id=migrate-target-${TARGETARCH},target=/build/target,sharing=locked \
    --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    cargo build --release -p desire-common --bin desire-migrate \
    --locked \
    && mkdir -p /out \
    && cp target/release/desire-migrate /out/migrate

# ---------- runner ----------
FROM ${REGISTRY}/debian:trixie
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /out/migrate /app/migrate
# 迁移 SQL 冷拷入镜像(cwd=/app 时默认探测 ./migrations 即命中)
COPY --from=builder /build/crates/common/migrations /app/migrations

ENTRYPOINT ["/app/migrate"]
